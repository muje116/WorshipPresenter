{
  "name": "worship-presenter",
  "version": "0.1.0",
  "description": "WorshipPresenter - Cross-platform worship presentation software",
  "main": "dist/src/main/electron.js",
  "scripts": {
    "start": "electron .",
    "build": "tsc && node scripts/build-renderer.js && echo Build complete;",
    "build:ts": "tsc",
    "build:renderer": "node scripts/build-renderer.js",
    "postinstall": "electron-builder install-app-deps",
    "test": "jest",
    "test:e2e": "playwright test",
    "dev": "tsc && node scripts/build-renderer.js && electron .",
    "dev:watch": "tsc && node scripts/build-renderer.js && start tsc -w && start node scripts/build-renderer.js --watch && electron ."
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9",
    "tslib": "^2.8.1",
    "typescript": "^6.0.2",
    "@playwright/test": "^1.56.1"
    ,"@testing-library/react": "^16.3.0"
    ,"@testing-library/jest-dom": "^6.9.1"
    ,"jest-environment-jsdom": "^30.2.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "path": "^0.12.7",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^4.2.2",
    "ws": "^8.20.0",
    "zustand": "^5.0.12"
  },
  "build": {
    "appId": "com.yourcompany.worshipresenter",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
